# ---------------------------------------------------------------------------
# Environment configuration template
#
# NEVER commit real credentials. Copy this file to `.env.local` for local
# development (it is git-ignored) and set real values there:
#
#   cp .env.example .env.local
#
# Local Supabase functions:   npm run functions:serve      # --env-file .env.local
# Hosted Supabase secrets:    npx supabase secrets set --env-file .env.sandbox
#
# `supabase/functions/_shared/config/env.ts` validates everything below and refuses to
# start with an incomplete or inconsistent environment. Errors name the VARIABLE only.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
# development | sandbox | production
#
# This value decides which Wompi credentials are LEGAL to load:
#   development / sandbox -> pub_test_*, prv_test_*, test_integrity_*, test_events_*
#   production            -> pub_prod_*, prv_prod_*, prod_integrity_*, prod_events_*
# Mixing them is rejected at startup, on purpose.
APP_ENV=development
SERVICE_NAME=event-ticketing

# debug | info | warn | error  (debug is rejected in production: debug payloads can leak data)
LOG_LEVEL=debug

# IANA time zone used for operator-facing dates (event is in Colombia).
TIMEZONE=America/Bogota

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Local development URL: http://127.0.0.1:54321   (see `npx supabase status`)
# Hosted URL:             https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# SERVER-SIDE SECRET KEY. Two accepted forms:
#   * new (recommended): sb_secret_...      (Settings > API Keys)
#   * legacy:            service_role JWT   (Settings > API > service_role, deprecated by
#                                            end of 2026 — `npx supabase status` prints it
#                                            for the LOCAL stack)
# A publishable/anon key is rejected: the backend needs full database authority.
# This key must never reach the browser, a log line or a repository.
SUPABASE_SECRET_KEY=REPLACE_WITH_LOCAL_service_role_key_FROM_SUPABASE_STATUS

# Platform-provided alternates, used only when the variable above is unset, in this order.
# The `SUPABASE_` prefix is reserved on hosted Supabase: a deployment there cannot define a
# custom SUPABASE_SECRET_KEY, so these are how the hosted backend gets its key.
#   * SUPABASE_SECRET_KEYS        JSON bag of secret keys; its "default" entry is used
#   * SUPABASE_SERVICE_ROLE_KEY   legacy platform key
# Leave them unset locally (the explicit variable above wins); hosted projects inject them.
# SUPABASE_SECRET_KEYS=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Payment provider (epayco | wompi)
# ---------------------------------------------------------------------------
# Active payment gateway provider: epayco (default) or wompi (legacy/transition).
PAYMENT_PROVIDER=epayco

# ---------------------------------------------------------------------------
# ePayco (Colombia) - https://epayco.com - https://docs.epayco.com
# ---------------------------------------------------------------------------
# Required when PAYMENT_PROVIDER=epayco.
# Credentials from ePayco dashboard: Integraciones > Llaves API
EPAYCO_PUBLIC_KEY=REPLACE_WITH_EPAYCO_PUBLIC_KEY
EPAYCO_PRIVATE_KEY=REPLACE_WITH_EPAYCO_PRIVATE_KEY
EPAYCO_P_KEY=REPLACE_WITH_EPAYCO_P_KEY
EPAYCO_CUST_ID_CLIENTE=REPLACE_WITH_EPAYCO_CUST_ID_CLIENTE
EPAYCO_TEST=true
# EPAYCO_BASE_URL=https://secure.epayco.co/validation/v1/reference

# ---------------------------------------------------------------------------
# Wompi (Colombia) - https://docs.wompi.co
# ---------------------------------------------------------------------------
# All four values come from the Wompi merchant dashboard:
#   Developers > Secrets for technical integration  (public key, integrity secret, events secret)
#   Developers > API keys                           (private key)
#
# Sandbox base URL:    https://sandbox.wompi.co/v1
# Production base URL: https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_REPLACE_ME
WOMPI_PRIVATE_KEY=prv_test_REPLACE_ME
WOMPI_INTEGRITY_SECRET=test_integrity_REPLACE_ME
WOMPI_EVENTS_SECRET=test_events_REPLACE_ME

# Development-only override so tests can point at a local fake Wompi server.
# Rejected whenever APP_ENV is sandbox or production.
# WOMPI_BASE_URL=http://127.0.0.1:8787/v1

# Where the buyer returns after paying, for both providers (Wompi `redirect-url`, ePayco session
# `response`). INFORMATIVE ONLY: the return page is never proof of payment (only a verified
# event or a server-side lookup is).
PAYMENT_RETURN_URL=http://localhost:3000/gracias
# Legacy name, read only when PAYMENT_RETURN_URL is not set. Prefer PAYMENT_RETURN_URL.
# WOMPI_REDIRECT_URL=http://localhost:3000/gracias

# ---------------------------------------------------------------------------
# Order reservations
# ---------------------------------------------------------------------------
# How long a PENDING order holds its inventory, in minutes (1-1440).
# TECHNICAL DEFAULT (15) until the client confirms the real window; the value is
# configuration, not a business decision baked into code.
ORDER_RESERVATION_MINUTES=15

# ---------------------------------------------------------------------------
# Email (Resend) - https://resend.com
# ---------------------------------------------------------------------------
# EMAIL_ENABLED defaults to true outside development and false inside development.
# When enabled, RESEND_API_KEY and EMAIL_FROM are required.
EMAIL_ENABLED=false
RESEND_API_KEY=re_REPLACE_ME
# Either `pedro@dominio.com` or `Boleteria <no-responder@dominio.com>` (verified domain).
EMAIL_FROM=Boleteria <no-responder@example.com>
EMAIL_REPLY_TO=contacto@example.com

# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------
# Public site (Vercel, built later). Used for the Wompi redirect URL and email links.
PUBLIC_WEB_BASE_URL=http://localhost:3000
# Base URL of this backend's Edge Functions.
# Hosted form: https://<project-ref>.supabase.co/functions/v1
API_BASE_URL=http://127.0.0.1:54321/functions/v1

# Optional: public ticket page linked from the confirmation email. It is a later frontend
# deliverable, so when this is unset the email simply shows the ticket code as text instead
# of linking to a page that does not exist yet.
# TICKET_BASE_URL=https://evento.example/entrada

# ---------------------------------------------------------------------------
# Email dispatch
# ---------------------------------------------------------------------------
# How many confirmation emails one dispatch run may send (1-100). The outbox is drained
# after a webhook confirmation and by the maintenance endpoint below.
EMAIL_DISPATCH_BATCH_SIZE=10

# ---------------------------------------------------------------------------
# Operator authentication (no variable)
# ---------------------------------------------------------------------------
# The check-in API authenticates real Supabase Auth users (email + password or a magic
# link) and authorizes them through a row in `public.operators` (role OPERATOR, active).
# There is NO shared operator secret: nothing here, and nothing in the future frontend.
# Create the operator accounts with docs/environments.md ("Operator accounts").

# Shared secret for the scheduled maintenance endpoint (expiry + reconciliation +
# email retries + Sheets projection + cleanup). Required outside development; minimum
# 32 characters. Generate with:
#   openssl rand -hex 32
#   curl -X POST "$API_BASE_URL/orders-maintenance" -H "authorization: Bearer $MAINTENANCE_API_TOKEN"
MAINTENANCE_API_TOKEN=replace-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Google Sheets operational projection (optional)
# ---------------------------------------------------------------------------
# A READ-ONLY projection for the client's operations; it can never affect payments,
# ticket issuance or check-in. With SHEETS_ENABLED=false the projection is skipped and
# every maintenance job still runs. Setup: docs/operations-google-sheets.md.
SHEETS_ENABLED=false
# The dedicated service account the client shares the spreadsheet with (as Editor).
GOOGLE_SERVICE_ACCOUNT_EMAIL=REPLACE_ME@REPLACE_ME.iam.gserviceaccount.com
# PKCS#8 PEM of that service account's key. Either escaped \n or real newlines.
GOOGLE_PRIVATE_KEY=REPLACE_WITH_SERVICE_ACCOUNT_PKCS8_PEM
# The id from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=REPLACE_WITH_SPREADSHEET_ID
# Tab names inside the spreadsheet (created by the first sync).
GOOGLE_SHEETS_DATA_TAB=Datos
GOOGLE_SHEETS_STATUS_TAB=Estado

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# PostgreSQL-backed fixed windows (no Redis). Keep enabled. `false` is a documented
# emergency switch that removes an abuse control (docs/environments.md).
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated exact origins. Required outside development; `*` is rejected and
# localhost origins are rejected outside development.
CORS_ALLOWED_ORIGINS=http://localhost:3000
