# ---------------------------------------------------------------------------
# Supabase Edge Functions - Staging Environment Secrets Template
# Target Project Ref: soqmdpqjjdmdhtgsutab
# Target Project URL: https://soqmdpqjjdmdhtgsutab.supabase.co
#
# Usage:
#   1. Copy to a local secrets file (e.g. `.env.staging.secrets`)
#   2. Fill in the placeholder values
#   3. Deploy secrets to staging via Supabase CLI:
#      npx supabase secrets set --env-file .env.staging.secrets --project-ref soqmdpqjjdmdhtgsutab
#
# Note: `SUPABASE_URL` and `SUPABASE_SERVICE_ROLE_KEY` / `SUPABASE_SECRET_KEYS`
# are automatically supplied by the hosted Supabase platform; do not set them manually.
# ---------------------------------------------------------------------------

APP_ENV=sandbox
SERVICE_NAME=event-ticketing
LOG_LEVEL=info
TIMEZONE=America/Bogota

# Active Payment Provider
PAYMENT_PROVIDER=epayco

# ePayco Sandbox / Test configuration
# Obtain test credentials from ePayco Dashboard: Integraciones > Llaves API
EPAYCO_PUBLIC_KEY=REPLACE_WITH_EPAYCO_PUBLIC_KEY
EPAYCO_PRIVATE_KEY=REPLACE_WITH_EPAYCO_PRIVATE_KEY
EPAYCO_P_KEY=REPLACE_WITH_EPAYCO_P_KEY
EPAYCO_CUST_ID_CLIENTE=REPLACE_WITH_EPAYCO_CUST_ID_CLIENTE
EPAYCO_TEST=true

# Operational & reservation settings
ORDER_RESERVATION_MINUTES=15
# This phase intentionally sends no buyer email: ticket emails are discontinued and the
# purchase welcome email is deferred. Keep false until the email design and Resend sender
# are approved.
EMAIL_ENABLED=false
RATE_LIMIT_ENABLED=true
MAINTENANCE_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Google Sheets operational projection (optional, Apps Script connector).
# Keep SHEETS_ENABLED=false until the web app is deployed and the signed health and
# self-test checks succeed. The spreadsheet ID and tab names live only in Apps Script
# Script Properties; create Datos and Estado manually in the spreadsheet.
# Setting SHEETS_ENABLED=true without both connector values makes the configuration
# loader reject every Edge Function, not just orders-maintenance.
SHEETS_ENABLED=false
# Deployed Apps Script URL ending in /exec.
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
# Shared HMAC secret, identical to Apps Script HMAC_SECRET. Never commit the real value.
# GOOGLE_APPS_SCRIPT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Current staging deployment (verified 2026-10-24): the ePayco, URL, CORS and maintenance
# secrets are configured. Google Sheets is NOT configured yet; it is not a purchase blocker.

# Public URLs for staging
# `PUBLIC_WEB_BASE_URL` must identify the actual staging frontend URL (e.g. Vercel preview or custom staging domain).
PUBLIC_WEB_BASE_URL=https://REPLACE_WITH_ACTUAL_STAGING_FRONTEND_URL
API_BASE_URL=https://soqmdpqjjdmdhtgsutab.supabase.co/functions/v1
# Where ePayco returns the buyer after paying (the frontend's `/gracias` route).
PAYMENT_RETURN_URL=https://REPLACE_WITH_ACTUAL_STAGING_FRONTEND_URL/gracias
# `CORS_ALLOWED_ORIGINS` must match the actual staging frontend origin (comma-separated if multiple, https only, no paths).
CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_ACTUAL_STAGING_FRONTEND_ORIGIN
