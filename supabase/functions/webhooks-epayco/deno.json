{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.117.2",
    "zod": "npm:zod@4.6.5"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "deno.window", "esnext"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
